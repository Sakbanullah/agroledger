generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                Int                @id @default(autoincrement())
  name              String
  email             String             @unique
  passwordHash      String
  role              String             @default("USER")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  moneyTransactions MoneyTransaction[]
}

model Setting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Person {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  type      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farmOwners       FarmOwner[]
  rubberWorkers    RubberSaleWorker[]
  creditAccount    CreditAccount?
  settlements      Settlement[]
  ownerSettlements OwnerSettlement[]
}

model Farm {
  id            Int      @id @default(autoincrement())
  name          String
  location      String?
  ownershipType String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owners            FarmOwner[]
  harvests          Harvest[]
  sales             Sale[]
  moneyTransactions MoneyTransaction[]
}

model FarmOwner {
  id                  Int      @id @default(autoincrement())
  farmId              Int
  personId            Int
  ownershipPercentage Decimal? @db.Decimal(5, 2)
  createdAt           DateTime @default(now())

  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([farmId, personId])
}

model Commodity {
  id        Int      @id @default(autoincrement())
  name      String
  unit      String   @default("KG")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  harvests Harvest[]
  sales    Sale[]
}

model Harvest {
  id          Int      @id @default(autoincrement())
  farmId      Int
  commodityId Int
  harvestDate DateTime
  weightKg    Decimal  @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  farm      Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  commodity Commodity @relation(fields: [commodityId], references: [id], onDelete: Restrict)
}

model Sale {
  id            Int      @id @default(autoincrement())
  farmId        Int
  commodityId   Int
  saleDate      DateTime
  pricePerKg    Decimal? @db.Decimal(12, 2)
  totalWeightKg Decimal? @db.Decimal(12, 2)
  buyerName     String?
  status        String   @default("PENDING")
  notes         String?

  // Snapshot of Farm.ownershipType at sale creation time.
  // Nullable because historical sales predate this field.
  ownershipType String?

  // Commission fields are only populated for Sawit + RELATIVE sales,
  // and only AFTER the buyer pays and the rate is agreed.
  commissionRatePerKg Decimal? @db.Decimal(12, 2)
  commissionAmount    Decimal? @db.Decimal(12, 2)
  ownerShareAmount    Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm             Farm               @relation(fields: [farmId], references: [id], onDelete: Restrict)
  commodity        Commodity          @relation(fields: [commodityId], references: [id], onDelete: Restrict)
  rubberWorkers    RubberSaleWorker[]
  settlements      Settlement[]
  ownerSettlements OwnerSettlement[]
  scanDocuments    ScanDocument[]
  // The cancellation record for this sale, if it was cancelled.
  cancellation      SaleCancellation?  @relation("CancelledSale")
}

// Audit record of a cancelled sale. It survives the sale, so its money rows
// (referenceType "SALE_CANCELLATION") keep meaning after the sale is deleted.
model SaleCancellation {
  id           Int      @id @default(autoincrement())
  // Nullable on purpose: the record survives the sale's deletion, so the
  // money rows it owns never point at a missing row.
  saleId       Int?     @unique
  commodity    String
  farmName     String
  saleDate     DateTime
  totalWeightKg Decimal? @db.Decimal(12, 2)
  pricePerKg   Decimal? @db.Decimal(12, 2)
  status       String   @default("CANCELLED")

  cancelledAt DateTime @default(now())

  sale Sale? @relation("CancelledSale", fields: [saleId], references: [id], onDelete: SetNull)

  @@index([saleId])
}

model RubberSaleWorker {
  id        Int      @id @default(autoincrement())
  saleId    Int
  workerId  Int
  pieces    Int
  weightKg  Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  worker Person @relation(fields: [workerId], references: [id], onDelete: Restrict)

  // One worker may be weighed several times (too many pieces for one scale
  // load). pieces/weightKg above always hold the sum of these rows.
  weighings RubberSaleWorkerWeighing[]

  @@unique([saleId, workerId])
}

model RubberSaleWorkerWeighing {
  id                 Int      @id @default(autoincrement())
  rubberSaleWorkerId Int
  pieces             Int
  weightKg           Decimal  @db.Decimal(12, 2)
  createdAt          DateTime @default(now())

  rubberSaleWorker RubberSaleWorker @relation(fields: [rubberSaleWorkerId], references: [id], onDelete: Cascade)

  @@index([rubberSaleWorkerId])
}

model CreditAccount {
  id        Int      @id @default(autoincrement())
  personId  Int      @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person       Person              @relation(fields: [personId], references: [id], onDelete: Restrict)
  transactions CreditTransaction[]
}

model CreditTransaction {
  id              Int      @id @default(autoincrement())
  creditAccountId Int
  type            String
  amount          Decimal  @db.Decimal(12, 2)
  transactionDate DateTime
  description     String?
  reference       String?
  createdAt       DateTime @default(now())

  creditAccount CreditAccount @relation(fields: [creditAccountId], references: [id], onDelete: Restrict)
}

model Settlement {
  id       Int @id @default(autoincrement())
  saleId   Int
  workerId Int

  grossShare      Decimal @db.Decimal(12, 2)
  kasbonAmount    Decimal @db.Decimal(12, 2)
  deductionAmount Decimal @db.Decimal(12, 2)
  netAmount       Decimal @db.Decimal(12, 2)

  // PENDING (calculated, nothing handed over) -> PAID_OUT (cash handed to the
  // worker) or SETTLED_BY_OFFSET (net 0, covered entirely by the kasbon
  // deduction, so no cash moved). CANCELLED is set when a cancelled sale is
  // deleted.
  status    String   @default("PENDING")
  // When the worker was actually settled (cash handed over or offset applied).
  // Never inferred from createdAt.
  settledAt DateTime?
  // Why status moved; complements the audit columns below.
  settlementMethod String?
  // Rubber worker settlement cash or CreditTransaction PAYMENT id written by
  // the settlement step. At most one of them is set; used to make the step
  // idempotent and is deliberately not a FK (the money row can outlive it).
  cashTransactionId    Int? @unique
  creditTransactionId  Int? @unique
  // Whether the record of an old settlement can be trusted. Orthogonal to
  // status: null = normal, REQUIRED = every normal payment is refused until
  // an admin resolves it, RESOLVED = decided with evidence (see
  // SettlementReconciliation). Never set by the normal payment path.
  reconciliationStatus String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sale            Sale                    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  worker          Person                  @relation(fields: [workerId], references: [id], onDelete: Restrict)
  reconciliations SettlementReconciliation[]

  @@unique([saleId, workerId])
  @@index([reconciliationStatus])
}

// Append-only audit trail of reconciliation decisions for one settlement.
// Each decision keeps the figures it was based on, the evidence rows it
// examined, and the statuses it moved between; earlier decisions are never
// edited or removed. No MoneyTransaction or CreditTransaction is written.
model SettlementReconciliation {
  id           Int @id @default(autoincrement())
  settlementId Int

  // PAID_OUT | SETTLED_BY_OFFSET (see reconciliation decisions in the code)
  decision String

  // Snapshot of the settlement figures the decision was taken on.
  grossShare      Decimal @db.Decimal(12, 2)
  deductionAmount Decimal @db.Decimal(12, 2)
  netAmount       Decimal @db.Decimal(12, 2)

  statusBefore String
  statusAfter  String

  // Historical rows the admin examined, as ids only. Nullable because a
  // decision may rest on the absence of a row. Not foreign keys: they point at
  // rows this decision must never change.
  reviewedMoneyTransactionId  Int?
  reviewedCreditTransactionId Int?

  reason String @db.Text

  // Trusted identity from the authenticated session, never a request body
  // value. Null only if the request had no authenticated user.
  decidedById Int?
  decidedAt   DateTime @default(now())

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  @@index([settlementId])
}

model ScanDocument {
  id        Int      @id @default(autoincrement())
  saleId    Int
  imagePath String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sale    Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  results ScanResult[]
}

model ScanResult {
  id             Int @id @default(autoincrement())
  scanDocumentId Int

  workerName String
  pieces     Int
  weightKg   Decimal  @db.Decimal(12, 2)
  confidence Decimal? @db.Decimal(5, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scanDocument ScanDocument @relation(fields: [scanDocumentId], references: [id], onDelete: Cascade)
}

model MoneyTransaction {
  id              Int      @id @default(autoincrement())
  type            String
  category        String
  amount          Decimal  @db.Decimal(12, 2)
  transactionDate DateTime
  description     String?
  referenceType   String?
  referenceId     Int?
  farmId          Int?
  createdBy       Int?
  createdAt       DateTime @default(now())

  farm Farm? @relation(fields: [farmId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([transactionDate])
  @@index([type])
  @@index([category])
  @@index([farmId])
}

model OwnerSettlement {
  id      Int @id @default(autoincrement())
  saleId  Int
  ownerId Int

  ownerShareAmount  Decimal @db.Decimal(12, 2)
  settledAmount     Decimal @default(0) @db.Decimal(12, 2)
  outstandingAmount Decimal @db.Decimal(12, 2)

  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sale  Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  owner Person @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@unique([saleId, ownerId])
  @@index([saleId])
  @@index([ownerId])
}

model LlmProvider {
  id        Int     @id @default(autoincrement())
  name      String
  protocol  String
  baseUrl   String
  // AES-256-GCM payload. Null means the endpoint needs no credential.
  apiKeyEnc String? @db.Text

  customHeaders Json?
  timeoutMs     Int     @default(60000)
  enabled       Boolean @default(true)
  isActive      Boolean @default(false)

  // Last connection test. Never set by a plain save: an untested provider
  // must not look connected.
  lastTestStatus  String?
  lastTestAt      DateTime?
  lastTestMessage String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models LlmModel[]

  @@index([isActive])
}

model LlmModel {
  id          Int     @id @default(autoincrement())
  providerId  Int
  modelId     String
  displayName String?
  params      Json?
  isDefault   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider LlmProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, modelId])
}
